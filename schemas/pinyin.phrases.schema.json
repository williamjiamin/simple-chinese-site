{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://study.invalid/schemas/pinyin.phrases.schema.json",
  "title": "Explicitly annotated tone display phrases",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "phrases"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "phrases": {
      "type": "array", "minItems": 1, "maxItems": 256,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "translation", "tokens"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z][a-z0-9_-]*$"},
          "translation": {"type": "string", "minLength": 1, "maxLength": 512},
          "tokens": {
            "type": "array", "minItems": 1, "maxItems": 128,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["hanzi", "pinyin"],
              "properties": {
                "hanzi": {"type": "string", "minLength": 1, "maxLength": 16},
                "pinyin": {"type": "string", "minLength": 1, "maxLength": 32},
                "boundary_after": {"type": "boolean", "default": false},
                "ordinal": {"type": "boolean", "default": false},
                "neutral": {"type": "boolean", "default": false}
              }
            }
          }
        }
      }
    }
  }
}
